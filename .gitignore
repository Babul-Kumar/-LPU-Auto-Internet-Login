dist/

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── Environment / Secrets ───────────────────────────────────────────────────
# NEVER commit API keys, secrets, or credentials
.env
.env.*
!.env.example
